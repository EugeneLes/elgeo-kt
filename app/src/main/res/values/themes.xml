<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ElGeo" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FF0A0A0A</item>
    </style>

    <style name="Theme.ElGeo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0A0A0A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ElGeo</item>
    </style>

</resources>
